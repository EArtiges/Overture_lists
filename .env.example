# Overture Admin Boundary List Builder - Environment Configuration

# Parquet Data Path (optional)
# Leave unset to always use the latest Overture release on S3.
# Set it to pin a release or use local data. Can be S3, HTTP, or local file path.
# Note: Use theme=divisions (admins theme was deprecated in 2024)
# OVERTURE_PARQUET_PATH=s3://overturemaps-us-west-2/release/2026-09-23.1/theme=divisions/type=division/*.parquet

# Data Storage Directory
# Directory where list JSON files are stored
LIST_DATA_DIR=./list_data

# Streamlit Configuration (Docker)
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
